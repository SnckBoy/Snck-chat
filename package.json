{
  "name": "snck-chat",
  "version": "1.0.0",
  "private": true,
  "description": "Snck Chat - real-time username-first chat platform",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/launcher.js",
    "start": "node src/launcher.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:dev": "prisma migrate dev",
    "check": "node --check src/server.js && node --check src/launcher.js && node --check public/dm-open.js && node --check src/create-admin.js",
    "test": "node --test"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "morgan": "^1.10.0",
    "socket.io": "^4.8.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "prisma": "6.19.3"
  },
  "engines": {
    "node": ">=20"
  }
}
