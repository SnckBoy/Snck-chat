[Unit]
Description=Snck Chat real-time server
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/snck-chat
EnvironmentFile=/opt/snck-chat/.env
ExecStart=/usr/bin/node /opt/snck-chat/src/launcher.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/snck-chat

[Install]
WantedBy=multi-user.target
